      "lines": {
        "274": "function readConfig(env: NodeJS.ProcessEnv = process.env): GatewayConfig {",
        "275": "  const provider = (env.AI_GATEWAY_PROVIDER || '').trim();",
        "276": "  if (provider !== 'openai-compatible') {",
        "277": "    throw new AiGatewayError(503, 'AI gateway provider is not configured');",
        "278": "  }",
        "279": "",
        "280": "  const rawBaseUrl = (env.AI_GATEWAY_BASE_URL || '').trim();",
        "281": "  const apiKey = (env.AI_GATEWAY_API_KEY || '').trim();",
        "282": "  if (!rawBaseUrl) throw new AiGatewayError(503, 'AI gateway provider URL is not configured');",
        "283": "  const baseUrl = validateBaseUrl(rawBaseUrl, env);",
        "284": "  const local = baseUrl.hostname === 'localhost' || baseUrl.hostname === '127.0.0.1' || baseUrl.hostname === '::1';",
        "285": "  if (!apiKey && (!local || env.NODE_ENV === 'production')) {",
        "286": "    throw new AiGatewayError(503, 'AI gateway provider credential is not configured');",
        "287": "  }"
      }
    }
